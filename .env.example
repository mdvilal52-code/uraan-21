# Copy these into your host's environment variables (or a local .env / .env.local
# for development, or --env-file for Docker). All values are read server-side
# only, except the NEXT_PUBLIC_ ones, so secrets never reach the browser.

# ── Admin panel login ──────────────────────────────────────────────────
# Credentials for /admin. CHANGE THESE before going live. ADMIN_SESSION_SECRET
# can be any long random string; changing it logs everyone out.
#
# In PRODUCTION (NODE_ENV=production) the recovery login is disabled unless
# ADMIN_SESSION_SECRET is set — without it, the session cookie hash would be
# deterministic from these public defaults and forgeable by anyone with the
# source. If you skip setting it, sign in via Supabase Auth instead.
ADMIN_EMAIL=admin@omgauriputra.com
ADMIN_PASSWORD=omgauri2024
ADMIN_SESSION_SECRET=please-change-this-to-a-long-random-string

# ── Scheduled jobs (cron) ───────────────────────────────────────────────
# Any random secret string. Point your scheduler (system crontab, PM2 cron,
# GitHub Actions, or a hosted cron service) at /api/cron/* and send this value
# as `Authorization: Bearer <value>` — required so those routes (e.g. automatic
# abandoned-cart WhatsApp reminders, every 2h) can't be triggered by a public
# GET request. Example:
#   0 */2 * * * curl -fsS -H "Authorization: Bearer $CRON_SECRET" \
#     https://your-domain.com/api/cron/abandoned-cart-reminders
CRON_SECRET=

# ── Database (Supabase) ────────────────────────────────────────────────
# Stores leads and orders so the admin panel shows real data from any
# device. Create a free project at supabase.com, run supabase/schema.sql in
# the SQL Editor, then copy these from Project Settings → API.
# The service-role key is secret — never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# For product image uploads, also create a PUBLIC Storage bucket named
# "product-images" in Supabase → Storage.

# ── Backups (Admin → Backups) ───────────────────────────────────────────
# Automated Postgres dump + Storage bucket sync, written to disk on this
# server. Needs the `postgresql-client` package installed (for `pg_dump` /
# `psql`) and a DIRECT Postgres connection string — NOT the SUPABASE_URL
# above, which is the REST API host. Get it from Supabase → Project Settings
# → Database → Connection string (URI). Until this is set, Admin → Backups
# shows exactly what's missing and no backup silently "succeeds".
SUPABASE_DB_URL=
# Where backups are written on this server (default ./backups next to the app).
BACKUP_DIR=
# Retention: every backup from the last N days is kept, then 1/month for M
# months, the rest is deleted from disk automatically after each scheduled run.
BACKUP_RETENTION_DAILY=30
BACKUP_RETENTION_MONTHLY=12
# Comma-separated Supabase Storage buckets to sync into each backup.
BACKUP_STORAGE_BUCKETS=product-images
# Point a scheduler at /api/cron/backups the same way as the abandoned-cart
# reminder cron (reuses CRON_SECRET above). Example, once a day at 2am:
#   0 2 * * * curl -fsS -H "Authorization: Bearer $CRON_SECRET" \
#     https://your-domain.com/api/cron/backups

# ── Payments (Razorpay) ────────────────────────────────────────────────
# Real card / UPI / netbanking payments at checkout. Without these, checkout
# places the order without taking an online payment (demo mode).
# Get the keys from https://dashboard.razorpay.com → Settings → API Keys.
# The Key Id is public; the Key Secret must stay server-side.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── HubSpot CRM (contact + newsletter leads) ───────────────────────────
# Optional — leads already save to Supabase (step 3 in DEPLOYMENT.md) and show
# in Admin → CRM / Leads. Setting these ALSO pushes each lead to HubSpot.
# 1. In HubSpot create a Form (Marketing → Forms) with fields:
#    First name, Last name, Email, Phone number, Message.
# 2. Copy the Portal ID (Settings → Account) and the Form GUID
#    (from the form's embed code / share URL).
# Leave BOTH blank to skip HubSpot entirely.
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=

# ── Instagram feed (homepage) ──────────────────────────────────────────
# A long-lived Instagram Graph API access token for the business account.
# Get it via Meta for Developers → Instagram Graph API / Basic Display.
INSTAGRAM_ACCESS_TOKEN=

# Public Instagram profile URL used by the "Follow on Instagram" button.
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/omgpgems1975?igsh=dWNpa29wc3JmcHR6

# Public Facebook and YouTube profile URLs used in the footer/social links.
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/share/1GaU9yTr6i/
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@jitendersoni4595

# ── Traffic analytics (Google Analytics 4) ─────────────────────────────
# Visitor/session tracking + the admin Analytics page's "Traffic Sources"
# card. Create a GA4 property at https://analytics.google.com → Admin →
# Data Streams → Web, then copy the Measurement ID (starts with "G-").
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Shipping (Shiprocket) ───────────────────────────────────────────────
# Auto-generates AWB/tracking numbers, shipping labels and pickup manifests
# from the order detail screen. Without these, admins enter the courier name
# + tracking number manually (still fully functional, just not automated).
# Sign up at https://www.shiprocket.in, then use your account login here.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# ── SEO ────────────────────────────────────────────────────────────────
# Your live site URL (used for canonical links, sitemap and robots). Set this
# to your custom domain once you have one, e.g. https://www.omgauriputra.com
NEXT_PUBLIC_SITE_URL=https://www.omgauriputra.com
# Google Search Console verification code (the content="..." value from the
# "HTML tag" verification method).
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# ── Business location (Footer, Contact, About, LocalBusiness schema) ──────
# Override any of these to relocate the store without touching component
# code. All are optional — sensible defaults are baked in.
NEXT_PUBLIC_BUSINESS_NAME=Om Gauri Putra Gems Jewellery & Rudraksh
NEXT_PUBLIC_BUSINESS_ADDRESS_LINE1=Shop No. Ground Floor of Prop No. 2, KH No. 56/12/1 and 56/19
NEXT_PUBLIC_BUSINESS_ADDRESS_LINE2=Block C-1, Shyam Colony, Budh Vihar Phase-2, Near Citizen Public School
NEXT_PUBLIC_BUSINESS_CITY=Delhi
NEXT_PUBLIC_BUSINESS_STATE=Delhi
NEXT_PUBLIC_BUSINESS_PINCODE=110086
NEXT_PUBLIC_BUSINESS_COUNTRY=India
NEXT_PUBLIC_BUSINESS_COUNTRY_CODE=IN

# Verified store coordinates (already baked in as the default in
# lib/business.ts, so these only need setting here if the store relocates).
# Pinning exact GPS coordinates sidesteps text-address geocoding ambiguity.
NEXT_PUBLIC_BUSINESS_LAT=28.71548864683306
NEXT_PUBLIC_BUSINESS_LNG=77.08962878652694

# ── Admin auth — Supabase Auth (Phase 2) ───────────────────────────────
# Public anon key + URL for Supabase Auth sign-in (safe in the browser; RLS
# protects the data). Get them from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Email (Resend) — OTP codes + security alerts ───────────────────────
# Transactional email for 2FA email-OTP, new-device approval and login /
# location alerts. Create a key at https://resend.com → API Keys.
RESEND_API_KEY=
# Verified "from" address for security email (use a domain you control).
SECURITY_EMAIL_FROM="Om Gauri Putra Security <security@omgauriputra.com>"

# ── WhatsApp ───────────────────────────────────────────────────────────
# Public business number (digits only, with country code) used for all the
# wa.me "Chat on WhatsApp" buttons across the site and admin panel.
NEXT_PUBLIC_WHATSAPP_NUMBER=918851911653

# Where new-lead WhatsApp alerts are sent (digits only, international format).
# Defaults to NEXT_PUBLIC_WHATSAPP_NUMBER when unset. NOTE: delivery also needs
# WHATSAPP_TOKEN + WHATSAPP_PHONE_NUMBER_ID below to be set.
ADMIN_WHATSAPP_NUMBER=919128596443

# WhatsApp Business Cloud API (Meta) — lets the admin panel send messages
# (e.g. order updates) server-side and capture inbound chats as CRM leads.
# Create an app at developers.facebook.com → WhatsApp → API Setup.
#   WHATSAPP_TOKEN            permanent/long-lived access token
#   WHATSAPP_PHONE_NUMBER_ID  the Cloud API phone number id (not the number)
#   WHATSAPP_VERIFY_TOKEN     any secret string; used to verify the webhook
#                             at /api/whatsapp/webhook
#   WHATSAPP_APP_SECRET       the Meta app's secret (App Settings → Basic);
#                             verifies the X-Hub-Signature-256 header on each
#                             inbound webhook POST so forged messages can't
#                             become CRM leads. Optional but recommended.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# For new-lead alerts that must arrive OUTSIDE WhatsApp's 24-hour window, Meta
# requires a pre-approved template. In WhatsApp Manager create a template whose
# body has a single {{1}} placeholder (e.g. "New website lead 🔔 {{1}}"), then
# set its name + language here. Leave blank to fall back to plain text (which
# only delivers if the admin messaged the business number in the last 24h).
WHATSAPP_LEAD_TEMPLATE=
WHATSAPP_LEAD_TEMPLATE_LANG=en_US
# Number of {{n}} variables in that template (default 1). Set to 0 for a static
# template with no variables, or to test with Meta's built-in "hello_world".
WHATSAPP_LEAD_TEMPLATE_VARS=1

# For new-order alerts sent to the admin after every completed payment. Same
# rules apply — needs a pre-approved template for delivery outside the 24h
# window. Leave blank to fall back to plain text.
WHATSAPP_ORDER_TEMPLATE=
WHATSAPP_ORDER_TEMPLATE_LANG=en_US
WHATSAPP_ORDER_TEMPLATE_VARS=1

# For bulk WhatsApp campaigns (Admin → Campaigns) sent to customers/leads.
# REQUIRED for campaigns to actually reach anyone: Meta only delivers
# free-form text to a customer who messaged you in the last 24 hours, so a
# marketing blast needs a pre-approved template with a single {{1}}
# placeholder (e.g. "{{1}}" as the whole body, filled with your campaign
# message). Without this, campaigns fall back to plain text and mostly fail
# — the admin panel will show a warning explaining why.
WHATSAPP_CAMPAIGN_TEMPLATE=
WHATSAPP_CAMPAIGN_TEMPLATE_LANG=en_US
# Number of {{n}} variables in that template (default 1). Set to 0 for a static
# template with no variables, or to test with Meta's built-in "hello_world".
WHATSAPP_CAMPAIGN_TEMPLATE_VARS=1
